{
  "name": "tren-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "figures": "node figures/build.mjs",
    "assets": "node scripts/assets.mjs",
    "dev": "vite",
    "build": "pnpm assets && pnpm figures && node scripts/validate-assets.mjs && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/three": "^0.187.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "svelte-spa-router": "^5.1.1",
    "three": "^0.187.0"
  },
  "packageManager": "pnpm@12.9.1"
}
